# Backend API base URL. Matches the local FastAPI dev server (see backend/README.md).
VITE_API_BASE_URL=http://localhost:8000

# Dev only: where the Open button plays a video from until the backend has an open-content route.
# Paste a signed storage URL here, or leave empty and put a file at frontend/public/dev/sample-video.mp4.
VITE_CONTENT_DEV_URL=
