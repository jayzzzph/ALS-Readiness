# Database 
DB_PORT=5432
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=<your_pg_password>
DB_NAME=alsense_db

# JWT
# Do NOT copy these values verbatim - generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use two DIFFERENT values for the two keys below.
ACCESS_TOKEN_SECRET_KEY=replace-with-a-random-64-char-hex-string
REFRESH_TOKEN_SECRET_KEY=replace-with-a-different-random-64-char-hex-string

# CORS
# Comma-separated list of allowed frontend origins. Defaults to the local Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Backblaze B2 (file storage)
# Optional — only needed to exercise the file-upload/download feature (see app/storage.py).
# Leave as placeholders if you're not working on that feature; the backend starts fine without
# real values.
B2_KEY_ID=placeholder_key_id
B2_APPLICATION_KEY=placeholder_application_key
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=placeholder-bucket-name


# EEG Stimulus Content
EEG_STIMULUS_FILE_KEY=eeg-stimulus/ab17f529-d4ca-4c09-86d6-08c7816e0cc9_stimulus_content.mp4
